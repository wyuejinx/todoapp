{
  "expo": {
    "name": "todo-frontend",
    "slug": "todo-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#05080A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05080A"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
